# MahaSetu Environment Configuration

ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Security / JWT
SECRET_KEY=mahasetu_sih_2026_super_secret_jwt_key_maharashtra_state
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL)
POSTGRES_USER=mahasetu_user
POSTGRES_PASSWORD=mahasetu_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mahasetu_db
DATABASE_URL=postgresql+asyncpg://mahasetu_user:mahasetu_pass@localhost:5432/mahasetu_db

# Cache & Event Bus (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Department Mock Adapters Latency Simulation (ms)
MOCK_ADAPTER_LATENCY_MS=200

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:8000"]
